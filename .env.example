# Copiar este archivo como ".env" y completar con los valores reales de CADA
# ambiente (nunca subir el .env real al repositorio, ya está en .gitignore).
#
# Para desarrollo local: apuntar a una base de datos de desarrollo/seed
# propia (no a la base de producción) con estos mismos nombres de variable.

NODE_ENV=development

DB_NAME=nombre_de_la_base
DB_USER=usuario_mysql
DB_PASS=contraseña_mysql
DB_HOST=host_mysql
DB_PORT=3306
DB_DIALECT=mysql

PORT=3000
FRONTEND_URL=http://localhost:5173

JWT_SECRET=un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# ── Recordatorios de Tareas: Google Calendar (opcional) ──
# Mientras falten estas 3 variables, simplemente no se crean eventos de
# calendario (no rompe nada). Ver instrucciones completas en
# src/services/calendarIntegration.js.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Recordatorios de Tareas: Email 48hs/24hs antes (opcional) ──
# Mientras falten SMTP_HOST/SMTP_USER/SMTP_PASS, no se envía ningún mail (no
# rompe nada). Sirve cualquier proveedor SMTP (Gmail con "Contraseña de
# aplicación", Google Workspace, SendGrid, etc). Ver
# src/services/emailReminders.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
