# Copiar este archivo como ".env" y completar con los valores reales de CADA
# ambiente (nunca subir el .env real al repositorio, ya está en .gitignore).
#
# Para desarrollo local: apuntar a una base de datos de desarrollo/seed
# propia (no a la base de producción) con estos mismos nombres de variable.

NODE_ENV=development

DB_NAME=nombre_de_la_base
DB_USER=usuario_mysql
DB_PASS=contraseña_mysql
DB_HOST=host_mysql
DB_PORT=3306
DB_DIALECT=mysql

PORT=3000
FRONTEND_URL=http://localhost:5173

JWT_SECRET=un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
